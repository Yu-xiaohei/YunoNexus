# YunoNexus .gitignore

# 环境变量和敏感配置
.env
.env.*
*.env
config.local.*
secrets.*

# 依赖目录
node_modules/
vendor/

# 构建输出
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go 相关
*.test
*.out
*.prof
coverage.txt
coverage.html

# Rust 相关
target/
Cargo.lock

# Flutter/Dart 相关
.dart_tool/
.packages
build/
*.iml
.idea/
.vscode/

# Tauri 相关
src-tauri/target/

# 数据库
*.db
*.sqlite
*.sqlite3

# 日志
*.log
logs/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# 测试文件（开发完成后删除）
test_*
*_test.go
*_test.dart
*_test.ts
*_test.js

# 归档的测试文件
tests/
test/

# 代理配置
.mimocode/
.claude/
.agents/
.codex/
